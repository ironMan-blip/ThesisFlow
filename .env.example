# Copy to .env and fill in every value. Never commit .env.

# Postgres login (docker compose builds DATABASE_URL from these).
# Only applied when the db volume is first created: after changing, run
# `docker compose down -v` (wipes data) or ALTER USER in psql.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Secret used to sign login tokens, e.g. output of `openssl rand -hex 32`.
JWT_SECRET=

# The single coordinator (admin) login. Created/updated on backend start.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_ID_NUMBER=
ADMIN_PASSWORD=

# Password for the dev accounts created by `python -m app.seed`.
SEED_PASSWORD=

# Only when running the backend outside docker:
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/thesisflow
# TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/thesisflow_test
